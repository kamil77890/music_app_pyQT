{
  "manifest_version": 2,
  "name": "Music Library Saver",
  "version": "1.0.0",
  "description": "Save YouTube music directly to your Jellyfin music library",

  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },

  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "http://localhost:8000/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": ["content/youtube.js"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "scripts": ["shared/api.js", "background.js"],
    "persistent": false
  },

  "sidebar_action": {
    "default_title": "Music Library",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": "icons/icon-48.png"
  },

  "browser_action": {
    "default_title": "Music Library Saver",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "music-library-saver@localhost",
      "strict_min_version": "68.0"
    }
  }
}
