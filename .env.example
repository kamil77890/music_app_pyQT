API_KEY=
API_KEY_2=

B2_KEY_ID=
B2_APPLICATION_KEY=
BUCKET_NAME=
ENDPOINT_URL=

GEMINI_API_KEY=
GEMINI_API_KEY_2=

# Database (subscriptions, notifications)
# Default: SQLite at DATA_DIR/music_app.db — no setup required.
# For PostgreSQL: docker compose up -d, then uncomment:
# DATABASE_URL=postgresql+psycopg2://music:music@localhost:5432/music_app

DATA_DIR=./data

# Advanced recommendations
TAG_ANALYZE_BATCH_SIZE=20
RECOMMENDATION_CACHE_TTL_HOURS=24
RECOMMENDATION_MAX_YT_CALLS=25
RECOMMENDATION_ENRICH_TOP=80

# Optional YouTube OAuth (import likes/playlists)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/youtube/callback
FERNET_KEY=

# Subtitle and local transcription settings
SUBTITLE_LANGS=pl,en,en-US
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Jellyfin music library integration
MUSIC_LIBRARY_PATH=/srv/music
MUSIC_LIBRARY_OWNER=
MUSIC_LIBRARY_GROUP=media
MUSIC_OUTPUT_FORMAT=keep
MUSIC_OUTPUT_BITRATE=320k

# When true, a copy of every downloaded/uploaded file is kept in FILEPATH
# in addition to the Jellyfin library (default: false)
MUSIC_KEEP_LEGACY_COPY=false

# Temporary directory for downloads/uploads before moving to Jellyfin library.
# If empty, defaults to FILEPATH/.tmp.
MUSIC_TEMP_PATH=

JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=
JELLYFIN_AUTO_SCAN=true
